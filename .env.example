# Stripe API Keys
# テストモード用のキーを使用してください
# https://dashboard.stripe.com/test/apikeys から取得
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# PayPay API Keys
# PayPay for Developers から取得
# https://developer.paypay.ne.jp/
PAYPAY_API_KEY=your_paypay_api_key_here
PAYPAY_API_SECRET=your_paypay_api_secret_here
PAYPAY_MERCHANT_ID=your_paypay_merchant_id_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (CORS設定用)
FRONTEND_URL=http://localhost:3000